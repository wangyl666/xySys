{"ast":null,"code":"import { mapState, mapGetters, mapActions } from 'vuex';\nimport SidebarItem from './components/SidebarItem.vue';\nexport default {\n  name: 'Layout',\n  components: {\n    SidebarItem\n  },\n  computed: {\n    ...mapState({\n      sidebar: state => state.app.sidebar,\n      device: state => state.app.device\n    }),\n    ...mapGetters(['permission_routes']),\n    activeMenu() {\n      const route = this.$route;\n      const {\n        meta,\n        path\n      } = route;\n      if (meta.activeMenu) {\n        return meta.activeMenu;\n      }\n      return path;\n    },\n    username() {\n      return this.$store.getters.name;\n    }\n  },\n  methods: {\n    ...mapActions({\n      toggleSideBar: 'app/toggleSideBar',\n      logout: 'user/logout'\n    }),\n    handleCommand(command) {\n      if (command === 'logout') {\n        this.$confirm('确定要退出登录吗?', '提示', {\n          confirmButtonText: '确定',\n          cancelButtonText: '取消',\n          type: 'warning'\n        }).then(() => {\n          this.logout().then(() => {\n            this.$router.push(`/login?redirect=${this.$route.fullPath}`);\n            this.$message.success('退出成功');\n          });\n        }).catch(() => {});\n      }\n    }\n  }\n};","map":{"version":3,"names":["mapState","mapGetters","mapActions","SidebarItem","name","components","computed","sidebar","state","app","device","activeMenu","route","$route","meta","path","username","$store","getters","methods","toggleSideBar","logout","handleCommand","command","$confirm","confirmButtonText","cancelButtonText","type","then","$router","push","fullPath","$message","success","catch"],"sources":["src/layout/index.vue"],"sourcesContent":["<template>\r\n  <div class=\"app-wrapper\">\r\n    <aside class=\"app-aside\" :class=\"{ 'is-collapsed': !sidebar.opened }\">\r\n      <div class=\"logo\">\r\n        <h2 v-if=\"sidebar.opened\">供应链管理系统</h2>\r\n        <h2 v-else>SCM</h2>\r\n      </div>\r\n      <el-menu\r\n        :default-active=\"activeMenu\"\r\n        :collapse=\"!sidebar.opened\"\r\n        :unique-opened=\"true\"\r\n        :router=\"true\"\r\n        background-color=\"#304156\"\r\n        text-color=\"#bfcbd9\"\r\n        active-text-color=\"#409EFF\"\r\n      >\r\n        <sidebar-item v-for=\"route in permission_routes\" :key=\"route.path\" :item=\"route\" :base-path=\"route.path\" />\r\n      </el-menu>\r\n    </aside>\r\n\r\n    <div class=\"app-main-container\">\r\n      <header class=\"app-header\">\r\n        <div class=\"header-left\">\r\n          <span class=\"collapse-btn\" @click=\"toggleSideBar\">\r\n            <i :class=\"sidebar.opened ? 'el-icon-s-fold' : 'el-icon-s-unfold'\"></i>\r\n          </span>\r\n          <el-breadcrumb separator=\"/\">\r\n            <el-breadcrumb-item v-for=\"item in $route.matched\" :key=\"item.path\">\r\n              {{ item.meta.title }}\r\n            </el-breadcrumb-item>\r\n          </el-breadcrumb>\r\n        </div>\r\n        <div class=\"header-right\">\r\n          <el-dropdown @command=\"handleCommand\">\r\n            <span class=\"user-info\">\r\n              <el-avatar :size=\"32\" icon=\"el-icon-user-solid\"></el-avatar>\r\n              <span class=\"username\">{{ username }}</span>\r\n              <i class=\"el-icon-arrow-down el-icon--right\"></i>\r\n            </span>\r\n            <el-dropdown-menu slot=\"dropdown\">\r\n              <el-dropdown-item command=\"profile\">个人中心</el-dropdown-item>\r\n              <el-dropdown-item command=\"logout\" divided>退出登录</el-dropdown-item>\r\n            </el-dropdown-menu>\r\n          </el-dropdown>\r\n        </div>\r\n      </header>\r\n\r\n      <main class=\"app-main\">\r\n        <transition name=\"fade-transform\" mode=\"out-in\">\r\n          <router-view />\r\n        </transition>\r\n      </main>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { mapState, mapGetters, mapActions } from 'vuex'\r\nimport SidebarItem from './components/SidebarItem.vue'\r\n\r\nexport default {\r\n  name: 'Layout',\r\n  components: { SidebarItem },\r\n  computed: {\r\n    ...mapState({\r\n      sidebar: state => state.app.sidebar,\r\n      device: state => state.app.device\r\n    }),\r\n    ...mapGetters([\r\n      'permission_routes'\r\n    ]),\r\n    activeMenu() {\r\n      const route = this.$route\r\n      const { meta, path } = route\r\n      if (meta.activeMenu) {\r\n        return meta.activeMenu\r\n      }\r\n      return path\r\n    },\r\n    username() {\r\n      return this.$store.getters.name\r\n    }\r\n  },\r\n  methods: {\r\n    ...mapActions({\r\n      toggleSideBar: 'app/toggleSideBar',\r\n      logout: 'user/logout'\r\n    }),\r\n    handleCommand(command) {\r\n      if (command === 'logout') {\r\n        this.$confirm('确定要退出登录吗?', '提示', {\r\n          confirmButtonText: '确定',\r\n          cancelButtonText: '取消',\r\n          type: 'warning'\r\n        }).then(() => {\r\n          this.logout().then(() => {\r\n            this.$router.push(`/login?redirect=${this.$route.fullPath}`)\r\n            this.$message.success('退出成功')\r\n          })\r\n        }).catch(() => {})\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style lang=\"scss\" scoped>\r\n.app-wrapper {\r\n  display: flex;\r\n  height: 100vh;\r\n  width: 100%;\r\n}\r\n\r\n.app-aside {\r\n  width: 210px;\r\n  background-color: #304156;\r\n  transition: width 0.3s;\r\n  overflow: hidden;\r\n  flex-shrink: 0;\r\n\r\n  &.is-collapsed {\r\n    width: 64px;\r\n  }\r\n\r\n  .logo {\r\n    height: 50px;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    background-color: #2b3a4a;\r\n\r\n    h2 {\r\n      color: #fff;\r\n      font-size: 18px;\r\n      font-weight: 600;\r\n      margin: 0;\r\n      white-space: nowrap;\r\n    }\r\n  }\r\n\r\n  ::v-deep .el-menu {\r\n    border-right: none;\r\n    width: 100%;\r\n  }\r\n}\r\n\r\n.app-main-container {\r\n  flex: 1;\r\n  display: flex;\r\n  flex-direction: column;\r\n  overflow: hidden;\r\n}\r\n\r\n.app-header {\r\n  height: 50px;\r\n  background-color: #fff;\r\n  box-shadow: 0 1px 4px rgba(0, 21, 41, 0.08);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  padding: 0 20px;\r\n  flex-shrink: 0;\r\n\r\n  .header-left {\r\n    display: flex;\r\n    align-items: center;\r\n\r\n    .collapse-btn {\r\n      font-size: 20px;\r\n      cursor: pointer;\r\n      margin-right: 15px;\r\n      padding: 5px;\r\n      transition: background-color 0.3s;\r\n\r\n      &:hover {\r\n        background-color: #f5f7fa;\r\n      }\r\n    }\r\n  }\r\n\r\n  .header-right {\r\n    display: flex;\r\n    align-items: center;\r\n\r\n    .user-info {\r\n      display: flex;\r\n      align-items: center;\r\n      cursor: pointer;\r\n\r\n      .username {\r\n        margin: 0 8px;\r\n        color: #606266;\r\n      }\r\n    }\r\n  }\r\n}\r\n\r\n.app-main {\r\n  flex: 1;\r\n  padding: 20px;\r\n  overflow-y: auto;\r\n  background-color: #f5f7fa;\r\n}\r\n\r\n.fade-transform-leave-active,\r\n.fade-transform-enter-active {\r\n  transition: all 0.5s;\r\n}\r\n\r\n.fade-transform-enter {\r\n  opacity: 0;\r\n  transform: translateX(-30px);\r\n}\r\n\r\n.fade-transform-leave-to {\r\n  opacity: 0;\r\n  transform: translateX(30px);\r\n}\r\n</style>\r\n"],"mappings":"AAyDA,SAAAA,QAAA,EAAAC,UAAA,EAAAC,UAAA;AACA,OAAAC,WAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IAAAF;EAAA;EACAG,QAAA;IACA,GAAAN,QAAA;MACAO,OAAA,EAAAC,KAAA,IAAAA,KAAA,CAAAC,GAAA,CAAAF,OAAA;MACAG,MAAA,EAAAF,KAAA,IAAAA,KAAA,CAAAC,GAAA,CAAAC;IACA;IACA,GAAAT,UAAA,EACA,oBACA;IACAU,WAAA;MACA,MAAAC,KAAA,QAAAC,MAAA;MACA;QAAAC,IAAA;QAAAC;MAAA,IAAAH,KAAA;MACA,IAAAE,IAAA,CAAAH,UAAA;QACA,OAAAG,IAAA,CAAAH,UAAA;MACA;MACA,OAAAI,IAAA;IACA;IACAC,SAAA;MACA,YAAAC,MAAA,CAAAC,OAAA,CAAAd,IAAA;IACA;EACA;EACAe,OAAA;IACA,GAAAjB,UAAA;MACAkB,aAAA;MACAC,MAAA;IACA;IACAC,cAAAC,OAAA;MACA,IAAAA,OAAA;QACA,KAAAC,QAAA;UACAC,iBAAA;UACAC,gBAAA;UACAC,IAAA;QACA,GAAAC,IAAA;UACA,KAAAP,MAAA,GAAAO,IAAA;YACA,KAAAC,OAAA,CAAAC,IAAA,y