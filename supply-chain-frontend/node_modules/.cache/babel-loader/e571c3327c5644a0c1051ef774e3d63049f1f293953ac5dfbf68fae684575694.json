{"ast":null,"code":"export default {\n  name: 'MyProcess',\n  data() {\n    return {\n      activeTab: 'myStarted',\n      myStartedList: [],\n      myInvolvedList: []\n    };\n  },\n  methods: {\n    formatTime(time) {\n      if (!time) return '';\n      return new Date(time).toLocaleString();\n    },\n    getResultType(result) {\n      const types = {\n        approved: 'success',\n        rejected: 'danger'\n      };\n      return types[result] || 'info';\n    },\n    getResultText(result) {\n      const texts = {\n        approved: '已通过',\n        rejected: '已拒绝'\n      };\n      return texts[result] || result;\n    }\n  }\n};","map":{"version":3,"names":["name","data","activeTab","myStartedList","myInvolvedList","methods","formatTime","time","Date","toLocaleString","getResultType","result","types","approved","rejected","getResultText","texts"],"sources":["src/views/workflow/my-process/index.vue"],"sourcesContent":["<template>\r\n  <div class=\"my-process-container\">\r\n    <el-card>\r\n      <template slot=\"header\">\r\n        <span>我的流程</span>\r\n      </template>\r\n      <el-tabs v-model=\"activeTab\">\r\n        <el-tab-pane label=\"我发起的\" name=\"myStarted\">\r\n          <el-table :data=\"myStartedList\" style=\"width: 100%\" border>\r\n            <el-table-column prop=\"processDefinitionName\" label=\"流程名称\" min-width=\"150\" />\r\n            <el-table-column prop=\"businessKey\" label=\"业务编号\" min-width=\"180\" />\r\n            <el-table-column prop=\"startTime\" label=\"发起时间\" min-width=\"160\">\r\n              <template slot-scope=\"scope\">\r\n                {{ formatTime(scope.row.startTime) }}\r\n              </template>\r\n            </el-table-column>\r\n            <el-table-column prop=\"endTime\" label=\"结束时间\" min-width=\"160\">\r\n              <template slot-scope=\"scope\">\r\n                {{ scope.row.endTime ? formatTime(scope.row.endTime) : '-' }}\r\n              </template>\r\n            </el-table-column>\r\n            <el-table-column prop=\"status\" label=\"状态\" width=\"100\">\r\n              <template slot-scope=\"scope\">\r\n                <el-tag :type=\"scope.row.status === 'running' ? 'warning' : 'info'\">\r\n                  {{ scope.row.status === 'running' ? '运行中' : '已结束' }}\r\n                </el-tag>\r\n              </template>\r\n            </el-table-column>\r\n            <el-table-column prop=\"result\" label=\"结果\" width=\"100\">\r\n              <template slot-scope=\"scope\">\r\n                <el-tag v-if=\"scope.row.status === 'ended'\" :type=\"getResultType(scope.row.result)\">\r\n                  {{ getResultText(scope.row.result) }}\r\n                </el-tag>\r\n                <span v-else>-</span>\r\n              </template>\r\n            </el-table-column>\r\n            <el-table-column label=\"操作\" width=\"150\">\r\n              <template slot-scope=\"scope\">\r\n                <el-button type=\"text\" size=\"small\">查看流程</el-button>\r\n                <el-button type=\"text\" size=\"small\">查看详情</el-button>\r\n              </template>\r\n            </el-table-column>\r\n          </el-table>\r\n          <el-empty v-if=\"myStartedList.length === 0\" description=\"暂无我发起的流程\" />\r\n        </el-tab-pane>\r\n        <el-tab-pane label=\"我参与的\" name=\"myInvolved\">\r\n          <el-table :data=\"myInvolvedList\" style=\"width: 100%\" border>\r\n            <el-table-column prop=\"processDefinitionName\" label=\"流程名称\" min-width=\"150\" />\r\n            <el-table-column prop=\"businessKey\" label=\"业务编号\" min-width=\"180\" />\r\n            <el-table-column prop=\"taskName\" label=\"我处理的任务\" min-width=\"150\" />\r\n            <el-table-column prop=\"startTime\" label=\"流程发起时间\" min-width=\"160\">\r\n              <template slot-scope=\"scope\">\r\n                {{ formatTime(scope.row.startTime) }}\r\n              </template>\r\n            </el-table-column>\r\n            <el-table-column prop=\"handleTime\" label=\"我处理的时间\" min-width=\"160\">\r\n              <template slot-scope=\"scope\">\r\n                {{ formatTime(scope.row.handleTime) }}\r\n              </template>\r\n            </el-table-column>\r\n            <el-table-column prop=\"result\" label=\"我的处理结果\" width=\"100\">\r\n              <template slot-scope=\"scope\">\r\n                <el-tag :type=\"getResultType(scope.row.result)\">\r\n                  {{ getResultText(scope.row.result) }}\r\n                </el-tag>\r\n              </template>\r\n            </el-table-column>\r\n            <el-table-column label=\"操作\" width=\"100\">\r\n              <template slot-scope=\"scope\">\r\n                <el-button type=\"text\" size=\"small\">查看详情</el-button>\r\n              </template>\r\n            </el-table-column>\r\n          </el-table>\r\n          <el-empty v-if=\"myInvolvedList.length === 0\" description=\"暂无我参与的流程\" />\r\n        </el-tab-pane>\r\n      </el-tabs>\r\n    </el-card>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'MyProcess',\r\n  data() {\r\n    return {\r\n      activeTab: 'myStarted',\r\n      myStartedList: [],\r\n      myInvolvedList: []\r\n    }\r\n  },\r\n  methods: {\r\n    formatTime(time) {\r\n      if (!time) return ''\r\n      return new Date(time).toLocaleString()\r\n    },\r\n    getResultType(result) {\r\n      const types = {\r\n        approved: 'success',\r\n        rejected: 'danger'\r\n      }\r\n      return types[result] || 'info'\r\n    },\r\n    getResultText(result) {\r\n      const texts = {\r\n        approved: '已通过',\r\n        rejected: '已拒绝'\r\n      }\r\n      return texts[result] || result\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style lang=\"scss\" scoped>\r\n.my-process-container {\r\n  padding: 0;\r\n}\r\n</style>\r\n"],"mappings":"AAiFA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,SAAA;MACAC,aAAA;MACAC,cAAA;IACA;EACA;EACAC,OAAA;IACAC,WAAAC,IAAA;MACA,KAAAA,IAAA;MACA,WAAAC,IAAA,CAAAD,IAAA,EAAAE,cAAA;IACA;IACAC,cAAAC,MAAA;MACA,MAAAC,KAAA;QACAC,QAAA;QACAC,QAAA;MACA;MACA,OAAAF,KAAA,CAAAD,MAAA;IACA;IACAI,cAAAJ,MAAA;MACA,MAAAK,KAAA;QACAH,QAAA;QACAC,QAAA;MACA;MACA,OAAAE,KAAA,CAAAL,MAAA,KAAAA,MAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}